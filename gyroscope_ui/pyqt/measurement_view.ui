<ui version="4.0">
 <class>MeasurementView</class>
 <widget class="QWidget" name="MeasurementView">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="GyroPlot" name="plot"/>
   </item>
   <item>
    <layout class="QHBoxLayout" name="layoutOptions">
     <item>
      <widget class="QCheckBox" name="checkAutoScroll">
       <property name="checked">
